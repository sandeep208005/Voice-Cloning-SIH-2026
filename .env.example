# DeepShield AI - Enterprise Configuration
ENVIRONMENT=development
PROJECT_NAME="DeepShield AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security
JWT_SECRET=deepshield_secure_multimodal_forensic_jwt_secret_key_2026_x89f
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite:///./deepshield.db
# For PostgreSQL: postgresql://deepshield:password@localhost:5432/deepshield_db

# Storage
STORAGE_DIR=./uploads
MAX_UPLOAD_SIZE_MB=100

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# AI Models Configuration
AI_DEVICE=cpu
MODEL_AUDIO_PATH=models/audio/vocoder_artifact_detector.pkl
MODEL_IMAGE_PATH=models/image/spatial_freq_detector.pkl
MODEL_VIDEO_PATH=models/video/temporal_consistency_detector.pkl
